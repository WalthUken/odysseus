NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Runtime data locations
ODYSSEUS_DATABASE_PATH=./data/odysseus.sqlite
ODYSSEUS_MASTER_KEY_PATH=./data/master.key

# Required in production. Supply through a secret manager, not this file.
ODYSSEUS_MASTER_KEY=

# Set the exact HTTPS origin and controlled proxy-hop count in production.
ODYSSEUS_ALLOWED_ORIGINS=
ODYSSEUS_TRUST_PROXY=0

# Optional administrator access. Provision the account first, then list its
# immutable numeric database ID. Never configure administrator usernames.
ODYSSEUS_ADMIN_USER_IDS=

# Optional local demo report viewer at /admin. It is rejected in production
# and from non-loopback clients. Keep the real value in .env only.
ODYSSEUS_DEMO_ADMIN_BYPASS=

# Optional grant and session durations in milliseconds
ODYSSEUS_SESSION_TTL_MS=28800000
ODYSSEUS_STEP_UP_GRANT_MS=600000
ODYSSEUS_BEHAVIOR_GRANT_MS=300000

# Optional advisory-only Gemini explanations. Keep the key server-side.
# Gemini output never changes the local authorization decision.
# The model id is verified against https://ai.google.dev/gemini-api/docs/models.
# Recheck that page and the deprecation page before each production rollout.
ODYSSEUS_GEMINI_API_KEY=
ODYSSEUS_GEMINI_MODEL=gemini-3.6-flash

# Optional provider request timeouts in milliseconds (1 to 30000).
# Each provider makes at most one extra retry, so the worst-case wait is
# roughly twice the configured timeout.
ODYSSEUS_GEMINI_TIMEOUT_MS=5000
ODYSSEUS_HUGGING_FACE_TIMEOUT_MS=3000

# Optional shadow-only Hugging Face anomaly scoring. Shadow output is recorded
# for comparison and never reaches an authorization decision.
ODYSSEUS_HUGGING_FACE_ENDPOINT=
ODYSSEUS_HUGGING_FACE_TOKEN=
ODYSSEUS_HUGGING_FACE_ALLOWED_HOSTS=

# Optional comma-separated providers that must be ready before /api/ready
# returns 200. Only list a provider whose readiness can succeed without a
# live request: gemini and hugging_face both stay "unchecked" until their
# first successful call, so listing them pins /api/ready at 503.
ODYSSEUS_REQUIRED_PROVIDERS=
