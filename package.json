{
  "name": "odysseus-behavioral-auth-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Functional behavioral authentication MVP using Scaled Manhattan Distance.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "mockup": "node mockup_website/server.js",
    "bot": "node scripts/mockup-demo-bot.js",
    "test": "node --test --test-isolation=none"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@simplewebauthn/server": "^13.3.2",
    "express": "^5.1.0",
    "pg": "^8.22.0",
    "redis": "^6.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0"
  }
}
